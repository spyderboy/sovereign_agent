# GalaxicanJS run — qwen2.5-coder size ladder (RECOMMENDED first run).
# Source before ./supervisor.sh:  source galaxicanjs_qwen25.env
#
# Same ladder as galaxicango_qwen25.env: cheap small model first, escalate
# on evidence, deterministic gates supervising. The JS scaffold is built
# for exactly this — every task is fill-in-the-body of a pre-stubbed,
# typed signature, which plays to small-coder strengths.
#
#   Tier 1  qwen2.5-coder:7b    ~4.7 GB — fast first pass
#   Tier 2  qwen2.5-coder:14b   ~9 GB   — main workhorse
#   Tier 3  qwen2.5-coder:32b   ~19 GB  — mop-up only
#
# Pull once:  for m in 7b 14b 32b; do ollama pull qwen2.5-coder:$m; done

export TIER1_MODEL=qwen2.5-coder:7b
export TIER2_MODEL=qwen2.5-coder:14b
export TIER3_MODEL=qwen2.5-coder:32b
export TIER4_MODEL=qwen2.5-coder:32b

export MODEL_PARAMS_TIER1=7
export MODEL_PARAMS_TIER2=14
export MODEL_PARAMS_TIER3=32
export MODEL_PARAMS_TIER4=32

export PLANNER_MODEL=qwen2.5-coder:7b
export ADVISOR_MODEL=qwen2.5-coder:7b
export RACE_MODEL=qwen2.5-coder:7b

export CTX_TIER1=32768
export CTX_TIER2=32768
export CTX_TIER3=32768
export CTX_TIER4=32768
export CTX_PLANNER=32768
export CTX_ADVISOR=32768
export CTX_RACE=32768

# Toolchain: Node >= 20 must be on PATH (no Go/Lexar exports needed).
# Validation + gates come from GalaxicanJS/.sovereign_config.json:
#   validate: npm run typecheck:sim && npm run test:locked
#   task/phase gates: vitest commands in each task's done-clause.
# Run `npm install` in the project once before the first worker session.
