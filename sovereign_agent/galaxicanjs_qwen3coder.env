# GalaxicanJS run — qwen3-coder:30b (30B MoE, 3B active) flat ladder,
# for the A/B against the qwen2.5 size ladder on the SAME task graph.
# Source before ./supervisor.sh:  source galaxicanjs_qwen3coder.env
#
# Flat ladder: qwen3-coder ships only 30b locally, so every tier and
# helper role points at the same checkpoint. NOTE: 30 >= the quick-mode
# cutoff (QUICK_PARAM_LIMIT_B=30), so `--quick` has ZERO eligible tiers
# with this env — run without --quick, or export QUICK_PARAM_LIMIT_B=31.

export TIER1_MODEL=qwen3-coder:30b
export TIER2_MODEL=qwen3-coder:30b
export TIER3_MODEL=qwen3-coder:30b
export TIER4_MODEL=qwen3-coder:30b

export MODEL_PARAMS_TIER1=30
export MODEL_PARAMS_TIER2=30
export MODEL_PARAMS_TIER3=30
export MODEL_PARAMS_TIER4=30

# One model string everywhere sidesteps the MODEL_CTX dict-collision
# gotcha (work.py keys context windows by MODEL NAME, not role).
export PLANNER_MODEL=qwen3-coder:30b
export ADVISOR_MODEL=qwen3-coder:30b
export RACE_MODEL=qwen3-coder:30b

export CTX_TIER1=32768
export CTX_TIER2=32768
export CTX_TIER3=32768
export CTX_TIER4=32768
export CTX_PLANNER=32768
export CTX_ADVISOR=32768
export CTX_RACE=32768

# Toolchain: Node >= 20 on PATH; `npm install` once in GalaxicanJS.
