# GalaxicanGo run — qwen3-coder:30b (30B MoE, 3B active) for every tier.
# Source this before ./work_go_qwen3coder or ./supervisor.sh:
#   source galaxicango_qwen3coder.env
#
# Why one model at every tier: qwen3-coder:30b (the "a3b" MoE checkpoint,
# 19GB at q4_K_M) is the model you asked to test head-to-head against the
# gemma4 ladder. There's no smaller/larger sibling tag to build a real
# escalation ladder from (qwen3-coder only ships 30b and 480b — see the
# 2026-07-13 chat where qwen3.6-coder and qwen3-coder-next turned out not
# to have the 4B/14B/32B tiers originally asked for). So this is a flat
# ladder: every tier and every helper role points at the same checkpoint.
# Pull once:  ollama pull qwen3-coder:30b
export TIER1_MODEL=qwen3-coder:30b
export TIER2_MODEL=qwen3-coder:30b
export TIER3_MODEL=qwen3-coder:30b
export TIER4_MODEL=qwen3-coder:30b

# Real total parameter count (30B) — see work.py's MODEL_PARAMS/QUICK_PARAM_LIMIT_B.
# IMPORTANT: 30 >= the quick-mode cutoff (QUICK_PARAM_LIMIT_B=30), so with this
# env sourced, `--quick` has ZERO eligible tiers (QUICK_MAX_TIER_IDX becomes 0)
# and will do nothing. Run WITHOUT --quick this time (full tier walk starting
# at tier 1), or export QUICK_PARAM_LIMIT_B=31 yourself if you want --quick to
# keep working against this specific checkpoint.
export MODEL_PARAMS_TIER1=30
export MODEL_PARAMS_TIER2=30
export MODEL_PARAMS_TIER3=30
export MODEL_PARAMS_TIER4=30

# Planner/advisor ride the same weights — simplest apples-to-apples config,
# and it sidesteps the MODEL_CTX dict-collision gotcha (work.py keys context
# windows by MODEL NAME, not by role — see work.py:113-123). Since every
# role below is the exact same model string, only ONE CTX_* value can ever
# take effect; setting them all equal below makes that moot instead of
# silently picking whichever env var happens to be last in the dict literal.
export PLANNER_MODEL=qwen3-coder:30b
export ADVISOR_MODEL=qwen3-coder:30b
export RACE_MODEL=qwen3-coder:30b

# All four CTX_* vars + planner/advisor/race set to the SAME value on purpose
# (see collision note above). 32768 matches the tier2-4 headroom already
# proven safe on this machine for a resident ~19GB model; qwen3-coder:30b
# supports up to 256K but KV cache cost scales with num_ctx regardless of
# MoE active-param count, so this stays conservative for a 32GB Mac.
export CTX_TIER1=32768
export CTX_TIER2=32768
export CTX_TIER3=32768
export CTX_TIER4=32768
export CTX_PLANNER=32768
export CTX_ADVISOR=32768
export CTX_RACE=32768

# Go toolchain on the Lexar (drive must be mounted — same rule as Android SDK).
export PATH="$PATH:/Volumes/Lexar/golang/go/bin"
export GOPATH=/Volumes/Lexar/golang/gopath
export GOMODCACHE=/Volumes/Lexar/golang/gomodcache
export GOCACHE=/Volumes/Lexar/golang/gocache
