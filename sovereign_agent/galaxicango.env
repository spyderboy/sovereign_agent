# GalaxicanGo run — all-Gemma-4 tier ladder, sized for M4 32 GB unified memory.
# Source this before ./work or ./supervisor.sh:  source galaxicango.env
#
# Ladder (escalate on failure, exactly like the qwen setup):
#   Tier 1  gemma4:e4b   edge 4B      — ~4-5 GB. Parallel workers OK (shared
#                                        weights, one ollama instance).
#   Tier 2  gemma4:12b   dense 12B    — ~8 GB. Single worker.
#   Tier 3  gemma4:26b   MoE (4B act) — ~16 GB. Single worker. Already proven
#                                        as galaxican's tier 2.
#   Tier 4  gemma4:31b   dense 31B    — ~19 GB. Single worker, nothing else
#                                        loaded (same footprint as the old
#                                        qwen2.5-coder:32b tier 4).
#
# Pull once:  for m in e4b 12b 26b 31b; do ollama pull gemma4:$m; done

export TIER1_MODEL=gemma4:e4b
export TIER2_MODEL=gemma4:12b
export TIER3_MODEL=gemma4:26b
export TIER4_MODEL=gemma4:31b

# Total param counts (billions) — drives QUICK_MAX_TIER_IDX (<30B for --quick):
# tiers 1-3 eligible for --quick, the 31B dense is mop-up only.
export MODEL_PARAMS_TIER1=4
export MODEL_PARAMS_TIER2=12
export MODEL_PARAMS_TIER3=26
export MODEL_PARAMS_TIER4=31

# Planner/advisor ride the tier-1 weights (same policy as the qwen setup —
# keeps only one small model resident during planning/advice).
export PLANNER_MODEL=gemma4:e4b
export ADVISOR_MODEL=gemma4:e4b
export RACE_MODEL=gemma4:e4b

# Context windows: e4b is tiny, give it the big window; keep the 31B dense at
# 32768 (the "prompt too large" floor found 2026-07-10) and watch memory.
export CTX_TIER1=65536
export CTX_TIER2=32768
export CTX_TIER3=32768
export CTX_TIER4=32768
export CTX_PLANNER=65536
export CTX_ADVISOR=65536
export CTX_RACE=65536

# Go toolchain on the Lexar (drive must be mounted — same rule as Android SDK).
export PATH="$PATH:/Volumes/Lexar/golang/go/bin"
export GOPATH=/Volumes/Lexar/golang/gopath
export GOMODCACHE=/Volumes/Lexar/golang/gomodcache
export GOCACHE=/Volumes/Lexar/golang/gocache
