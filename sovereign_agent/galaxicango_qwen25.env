# GalaxicanGo run — qwen2.5-coder REAL size ladder for the A/B against
# qwen3-coder:30b. Source before ./supervisor.sh:
#   source galaxicango_qwen25.env
#
# Unlike qwen3-coder (only one local size), 2.5-coder ships a genuine
# escalation ladder — this is also the sane version of the
# "Architect->Editor" idea: cheap small model first, escalate on evidence,
# with the deterministic gates (grounding, path, braces) doing the
# supervision instead of a second generative model.
#
#   Tier 1  qwen2.5-coder:7b    ~4.7 GB — fast first pass
#   Tier 2  qwen2.5-coder:14b   ~9 GB   — main workhorse
#   Tier 3  qwen2.5-coder:32b   ~19 GB  — mop-up only (slow load on 32 GB)
#
# Pull once:  for m in 7b 14b 32b; do ollama pull qwen2.5-coder:$m; done
#
# --quick note: params are 7/14/32, so with QUICK_PARAM_LIMIT_B=30 the
# quick pass uses tiers 1-2 and reserves the 32b for --deep / retry — the
# ladder semantics work WITHOUT overriding QUICK_PARAM_LIMIT_B.

export TIER1_MODEL=qwen2.5-coder:7b
export TIER2_MODEL=qwen2.5-coder:14b
export TIER3_MODEL=qwen2.5-coder:32b
export TIER4_MODEL=qwen2.5-coder:32b

export MODEL_PARAMS_TIER1=7
export MODEL_PARAMS_TIER2=14
export MODEL_PARAMS_TIER3=32
export MODEL_PARAMS_TIER4=32

# Planner/advisor ride the 7b — keeps one small model resident.
export PLANNER_MODEL=qwen2.5-coder:7b
export ADVISOR_MODEL=qwen2.5-coder:7b
export RACE_MODEL=qwen2.5-coder:7b

# Context windows (qwen2.5-coder supports 32k natively at these quants).
export CTX_TIER1=32768
export CTX_TIER2=32768
export CTX_TIER3=32768
export CTX_TIER4=32768
export CTX_PLANNER=32768
export CTX_ADVISOR=32768
export CTX_RACE=32768

# Go toolchain on the Lexar (drive must be mounted).
export PATH="$PATH:/Volumes/Lexar/golang/go/bin"
export GOPATH=/Volumes/Lexar/golang/gopath
export GOMODCACHE=/Volumes/Lexar/golang/gomodcache
export GOCACHE=/Volumes/Lexar/golang/gocache
